{
  // ============================================================
  //  STM32 OTA 项目 - VS Code 工作区配置
  //  组员克隆后自动生效，不需要手动改
  // ============================================================

  // ---------- 文件编码：统一 UTF-8 with BOM ----------
  // 必须带 BOM，否则 Keil 打开中文注释会乱码
  "files.encoding": "utf8bom",
  "files.autoGuessEncoding": false,

  // ---------- 换行符：CRLF（Keil 在 Windows 下的默认）----------
  "files.eol": "\r\n",
  "files.trimTrailingWhitespace": false,
  "files.insertFinalNewline": true,

  // ---------- 缩进：4 空格，不自动检测 ----------
  "editor.detectIndentation": false,
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.rulers": [],
  "editor.renderWhitespace": "none",

  // ---------- C 语言：关闭自动格式化（会破坏 Keil 代码风格）----------
  "[c]": {
    "editor.defaultFormatter": null,
    "editor.formatOnSave": false
  },

  // ---------- IntelliSense：强制使用 c_cpp_properties.json ----------
  "C_Cpp.intelliSenseEngine": "default",
  "C_Cpp.autocomplete": "default",
  "C_Cpp.errorSquiggles": "enabled",
  "C_Cpp.default.cStandard": "c99",
  "C_Cpp.default.intelliSenseMode": "gcc-arm",

  // 明确指定使用工程内的配置，不要自动探测
  "C_Cpp.default.includePath": [
    "${workspaceFolder}/APP工程/user",
    "${workspaceFolder}/APP工程/user/api",
    "${workspaceFolder}/APP工程/libraries/CMSIS",
    "${workspaceFolder}/APP工程/libraries/CMSIS/CM3",
    "${workspaceFolder}/APP工程/libraries/STM32F10x_StdPeriph_Driver/inc",
    "${workspaceFolder}/BootLoader工程/user",
    "${workspaceFolder}/BootLoader工程/user/api",
    "${workspaceFolder}/BootLoader工程/libraries/CMSIS",
    "${workspaceFolder}/BootLoader工程/libraries/CMSIS/CM3",
    "${workspaceFolder}/BootLoader工程/libraries/STM32F10x_StdPeriph_Driver/inc",
    "${workspaceFolder}/tools/armcc_include"
  ],
  "C_Cpp.default.defines": [
    "USE_STDPERIPH_DRIVER",
    "STM32F10X_HD"
  ],

  // ---------- 关闭 C/C++ Runner 插件的自动配置 ----------
  // 这个插件会往 settings.json 里乱写 GCC 配置，对 STM32 项目没用
  "C_Cpp_Runner.useMsvc": false,
  "C_Cpp_Runner.enableWarnings": false,
  "C_Cpp_Runner.warningsAsError": false,
  "C_Cpp_Runner.compilerArgs": [],
  "C_Cpp_Runner.linkerArgs": [],
  "C_Cpp_Runner.includePaths": [],
  "C_Cpp_Runner.includeSearch": [
    "*",
    "**/*"
  ],
  "C_Cpp_Runner.excludeSearch": [
    "**/build",
    "**/build/**",
    "**/Objects",
    "**/Objects/**",
    "**/Listings",
    "**/Listings/**",
    "**/.*",
    "**/.*/**",
    "**/.vscode",
    "**/.vscode/**"
  ],

  // ---------- 搜索排除：编译产物不参与搜索 ----------
  "search.exclude": {
    "**/Objects": true,
    "**/Listings": true,
    "**/.git": true
  },

  // ---------- 文件类型关联 ----------
  "files.associations": {
    "*.uvprojx": "xml",
    "*.uvoptx": "xml",
    "*.s": "arm",
    "*.h": "c"
  }
}
